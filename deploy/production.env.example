# NEXUS AI — PRODUCTION-ORIENTED CONFIGURATION TEMPLATE (no values: fill from your secret store).
# With APP_ENV=production the API and the worker refuse to start if any security-relevant setting
# is missing or unsafe (backend/app/config.py::validate_settings). Never commit filled-in copies.

APP_ENV=production
DEMO_MODE=false
AUTH_MODE=oidc
PROCESSING_MODE=queue
STORAGE_BACKEND=s3
DB_REQUIRE_RLS_ROLE=true

# Runtime database roles (row-level security enforced; created by migration 0008, LOGIN + password
# via scripts/provision_db_roles.py run with the migration role)
DATABASE_URL=postgresql+psycopg://nexus_app:<secret>@<db-host>:5432/nexus?sslmode=require
WORKER_DATABASE_URL=postgresql+psycopg://nexus_worker:<secret>@<db-host>:5432/nexus?sslmode=require
# Only for the migrate / backfill / reconcile jobs (privileged; never set on api / worker):
# MIGRATION_DATABASE_URL=postgresql+psycopg://<owner>:<secret>@<db-host>:5432/nexus?sslmode=require

# OpenID Connect (any standards-compliant IdP)
OIDC_ISSUER=https://idp.example.com/realms/nexus
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=nexus-bff
OIDC_CLIENT_SECRET=<secret>
OIDC_REDIRECT_URI=https://nexus.example.com/api/auth/oidc/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://nexus.example.com/
OIDC_ALLOWED_ALGS=RS256
OIDC_API_AUDIENCE=nexus-api
OIDC_GROUP_CLAIM=groups
OIDC_TENANT_PREFIX=/tenants/
OIDC_ALLOWED_TENANTS=<tenant-a>,<tenant-b>
OIDC_LINK_VERIFIED_EMAIL=false
OIDC_JIT_PROVISIONING=true

# Browser sessions (cookie becomes __Host-nexus_session: Secure, HttpOnly, SameSite=Lax)
SESSION_ENCRYPTION_KEY=<32 random bytes, base64>
SESSION_COOKIE_SECURE=true
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
SESSION_REVALIDATE_SECONDS=300
FRONTEND_ORIGINS=https://nexus.example.com

# Object storage (bucket-scoped credentials or an IAM role; leave keys empty to use the AWS chain)
S3_ENDPOINT_URL=
S3_REGION=eu-central-1
S3_BUCKET=<private-bucket>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_SERVER_SIDE_ENCRYPTION=aws:kms
PRESIGNED_DOWNLOADS=false

# Observability
LOG_FORMAT=json
METRICS_PORT=9100
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=https://otel-collector.internal:4318
OTEL_TRACES_SAMPLER_RATIO=0.1

# Optional LLM extraction / answers
OPENAI_API_KEY=
