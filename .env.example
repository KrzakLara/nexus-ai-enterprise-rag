# Local demo only: NEVER deploy these demo accounts or secrets publicly.
DEMO_MODE=true
DATABASE_URL=sqlite:///./data/nexus.db
STORAGE_DIR=./data/uploads
JWT_SECRET=change-this-local-demo-secret
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MAX_UPLOAD_MB=5
# Local embeddings (no API key). Dimension 384 is fixed by the database schema.
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Optional: pin a Hugging Face commit hash for reproducibility
EMBEDDING_MODEL_REVISION=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBED_ON_UPLOAD=true
# Load the embedding model at API startup (PostgreSQL only) so the first query is not a ~15 s cold start
EMBEDDING_WARMUP=true
# Hybrid retrieval (PostgreSQL FTS + pgvector, Reciprocal Rank Fusion)
RETRIEVAL_CANDIDATES=50
RRF_K=60
RRF_WEIGHT_LEXICAL=1.0
RRF_WEIGHT_SEMANTIC=1.0
# Evidence-sufficiency policy (semantic/hybrid). Defaults = dev-split calibration (eval/calibration.json).
# Similarity rules are OR-ed after the identifier rule; "none" DISABLES a rule (it is not a 0 threshold).
# Phase 2d policy: best query-selected SENTENCE cosine >= 0.835; the chunk-level cosine rule is off.
EVIDENCE_POLICY_ENABLED=true
EVIDENCE_MIN_SIMILARITY=none
EVIDENCE_MIN_SENTENCE_SIMILARITY=0.835
EVIDENCE_MIN_TERM_COVERAGE=none
EVIDENCE_REQUIRE_IDENTIFIER=true
EVIDENCE_ACCEPT_AGREEMENT=false

# --- Phase 4: enterprise hardening (local defaults; production values: deploy/production.env.example,
# docs/enterprise-hardening.md). The API refuses to start with an insecure combination. ---
# APP_ENV: local | development | test | staging | production
APP_ENV=local
# AUTH_MODE defaults to demo while DEMO_MODE=true; demo is refused outside local/development/test.
# AUTH_MODE=oidc                    # OIDC Authorization Code + PKCE through the backend (compose.oidc.yaml: Keycloak)
# OIDC_ISSUER=http://localhost:8080/realms/nexus
# OIDC_DISCOVERY_URL=               # optional internal URL of the discovery document
# OIDC_CLIENT_ID=nexus-bff
# OIDC_CLIENT_SECRET=               # from the IdP / a secret store, never committed
# OIDC_REDIRECT_URI=http://localhost:5173/api/auth/oidc/callback
# OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
# OIDC_API_AUDIENCE=nexus-api
# OIDC_ALLOWED_TENANTS=northstar,otherco   # server-side allowlist for /tenants/<t>/... group paths
# OIDC_JWKS_CACHE_SECONDS=300 / OIDC_JWKS_MIN_REFRESH_SECONDS=10 / OIDC_JWKS_STALE_MAX_SECONDS=3600
# Browser sessions (HttpOnly cookie). Refresh / ID tokens are encrypted with this 32-byte base64 key.
# SESSION_ENCRYPTION_KEY=
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Database pool (the API answers 503 + Retry-After when no connection frees up in time)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=10
# 503 + Retry-After when a response has not started after this many seconds (0 = off)
REQUEST_TIMEOUT_SECONDS=60
# Upper bound of each readiness probe (database, object storage, IdP)
READINESS_TIMEOUT_SECONDS=3
# DB_REQUIRE_RLS_ROLE=true          # default true in staging/production: refuse a BYPASSRLS / owner role
# Processing: inline (inside the request: tests, evaluation, SQLite demo) | queue (durable jobs, run the worker)
PROCESSING_MODE=inline
JOB_MAX_ATTEMPTS=5
JOB_LEASE_SECONDS=120
# Object storage: local (STORAGE_DIR) | s3 (MinIO / AWS S3; private bucket, server-generated keys)
STORAGE_BACKEND=local
# S3_ENDPOINT_URL=http://127.0.0.1:9000
# S3_BUCKET=nexus-documents
# S3_ACCESS_KEY_ID= / S3_SECRET_ACCESS_KEY=
PRESIGNED_DOWNLOADS=false
DELETION_GRACE_SECONDS=0
# Observability: JSON logs with redaction, Prometheus on an internal port, optional OTLP traces
LOG_FORMAT=json
LOG_LEVEL=INFO
# METRICS_PORT: 0 = off; compose uses 9100 (internal network only)
METRICS_PORT=0
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
